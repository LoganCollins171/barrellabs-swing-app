# Shape reference for .streamlit/secrets.toml — NOT real secrets.
# Copy this file to .streamlit/secrets.toml and fill in real values locally,
# or paste the equivalent structure into the hosting platform's secrets
# manager (e.g. Streamlit Community Cloud's "Advanced settings -> Secrets").
#
# See BL-003A for which keys the running app actually needs. In short:
# the app's own runtime only ever reads [supabase].url and
# [supabase].publishable_key, plus the [stripe] keys below. It never reads
# [supabase].service_role_key at runtime — that key is only used by the
# standalone admin script mint_beta_code.py, which is not part of the
# deployed web app. Recommended: leave service_role_key OUT of whatever
# secrets you paste into a hosting platform unless you specifically intend
# to run admin scripts there too.

[supabase]
url              = "https://<project-ref>.supabase.co"
publishable_key  = "<anon/publishable key, safe for client use>"
service_role_key = "<admin-only — NOT required by the deployed app, see note above>"

[stripe]
mode            = "test"
secret_key      = "<sk_test_... in test mode>"
publishable_key = "<pk_test_... in test mode>"
# webhook_signing_secret = "<whsec_...>"

price_solo_pro_monthly   = "<price_...>"
price_solo_pro_annual    = "<price_...>"
price_family_pro_monthly = "<price_...>"
price_family_pro_annual  = "<price_...>"
price_coach_pro_monthly  = "<price_...>"
price_coach_pro_annual   = "<price_...>"

# --- Live mode (later) ---
# live_secret_key             = "<sk_live_...>"
# publishable_key_live        = "<pk_live_...>"
# webhook_signing_secret_live = "<whsec_...>"
# price_solo_pro_monthly_live   = "<price_...>"
# price_solo_pro_annual_live    = "<price_...>"
# price_family_pro_monthly_live = "<price_...>"
# price_family_pro_annual_live  = "<price_...>"
# price_coach_pro_monthly_live  = "<price_...>"
# price_coach_pro_annual_live   = "<price_...>"

[posthog]
api_key = "<posthog project api key>"
host    = "<posthog host, e.g. https://us.i.posthog.com>"

[sentry]
dsn = "<sentry DSN>"
